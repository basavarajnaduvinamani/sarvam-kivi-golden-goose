# Kivi Configuration Example

KIVI_DATABASE_URL="sqlite:///./var/kivi.db"

# The provider for LLM and embeddings. Use "deterministic" for local offline testing.
KIVI_MODEL_PROVIDER="openai"

# OpenAI settings
OPENAI_API_KEY="sk-..."
KIVI_LLM_MODEL="gpt-4o"
KIVI_EMBEDDING_MODEL="text-embedding-3-small"

# Optional cost tracking (per million tokens)
KIVI_LLM_INPUT_COST_PER_MILLION=0.0
KIVI_LLM_OUTPUT_COST_PER_MILLION=0.0
KIVI_EMBEDDING_COST_PER_MILLION=0.0
